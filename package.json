    "verify:reflex-silent": "tsx scripts/verify-reflex-silent.ts",
    "verify:determinism": "tsx scripts/verify-determinism.ts",
    "sim:headless": "tsx scripts/verify-determinism.ts",
    "verify:theorem": "tsx scripts/verify-theorem.ts",
    "measure:latency": "tsx scripts/measure-latency.ts",
    "demo:live": "tsx scripts/demo-live.ts",
    "verify:social-information": "tsx scripts/verify-social-information.ts",
    "retrace:explore": "tsx scripts/retrace-explore.ts",
    "record:trace": "tsx scripts/record-trace.ts",
    "ablate": "tsx scripts/ablate.ts",
    "viewer": "python3 -m http.server 8080",
