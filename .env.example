# Each key is optional. A missing key degrades that participant to a documented
# fallback rather than failing the run. Phases 1-3 need none of them.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# Any OpenAI-compatible endpoint (OpenRouter, vLLM, Ollama, ...) for the
# deceiving pilot, which must not share a vendor with its interrogators.
OPENAI_COMPAT_BASE_URL=
OPENAI_COMPAT_API_KEY=

# Leave unset. When set, mozaik's EventPublisherLoopVisitor ships every agent's
# full memory, tools and manifest to JigJoy's cloud on every event. See docs/API-NOTES.md.
# MOZAIK_API_KEY=
